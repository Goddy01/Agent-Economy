{
  "name": "agent-colony",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "postinstall": "node scripts/patch-rpc-websockets.js",
    "build": "tsc",
    "start": "tsx src/index.ts",
    "setup": "tsx scripts/setup-devnet.ts",
    "teardown": "tsx scripts/teardown.ts",
    "restore-vault": "tsx scripts/restore-vault.ts",
    "recover-agent-sol": "tsx scripts/recover-agent-sol.ts",
    "show-agent-addresses": "tsx scripts/show-agent-addresses.ts",
    "check-balances": "tsx scripts/check-balances.ts",
    "generate-passphrase": "tsx scripts/generate-master-passphrase.ts",
    "test": "jest",
    "test:security": "jest tests/security-attacks.test.ts tests/transaction.test.ts --verbose",
    "test:watch": "jest --watch",
    "check-secrets": "node scripts/check-secrets.js",
    "security:check": "npm run check-secrets && npm audit --audit-level=high",
    "colony:run": "tsx src/index.ts",
    "colony:dry": "DRY_RUN=true tsx src/index.ts",
    "build:dashboard": "npm run build --prefix dashboard-app"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "dotenv": "^10.0.0",
    "@noble/ed25519": "^3.0.0",
    "@orca-so/common-sdk": "^0.2.2",
    "@orca-so/whirlpools-sdk": "^0.10.0",
    "argon2": "^0.44.0",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "ed25519-hd-key": "^1.3.0",
    "openai": "^6.25.0",
    "react": "^19.2.4",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "@types/react": "^19.2.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "bigint-buffer": "npm:bigint-buffer-fixed@1.1.6"
  }
}
