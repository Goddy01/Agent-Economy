# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# Key vault — this is the ONLY secret. All agent keys derive from this.
MASTER_PASSPHRASE=replace-with-strong-passphrase-minimum-32-chars

# AI Rationale (optional — system runs without this)
OPENAI_API_KEY=sk-...

# Colony config
MAX_TX_SOL=0.5
RATE_LIMIT_TX_PER_MINUTE=10
VAULT_FLOOR_SOL=5.0
COLONY_TICK_MS=15000

# Dashboard
DASHBOARD_REFRESH_MS=2000