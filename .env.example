# Solana
SOLANA_RPC_URL=https://api.devnet.solana.com

# Key vault - this is the ONLY secret. All agent keys derive from this.
# Generate one safely: npm run generate-passphrase (then paste the line into .env).
# Use double quotes only if the passphrase contains = or spaces.
MASTER_PASSPHRASE=

# Only for restore after losing .agent-colony-vault.json (24-word recovery phrase):
RECOVERY_PHRASE="word1 word2 ... word24"

# Funding: by default the colony has a "funder" agent. Send SOL to the funder wallet
# (address shown by npm run setup and on the dashboard). The funder distributes SOL to
# other agents so they can operate. No private key in .env needed.
TARGET_AGENT_SOL=1.0

# AI Rationale (optional - system runs without this)
OPENAI_API_KEY=sk-...

# Colony config - USDC (SPL) required for full demo. Top up funder with SOL first, then run npm run create-usdc-token (each run creates a new mint).
# USDC mint for SOL/USDC trading; required to see full system (pool, funder, traders)
USDC_MINT=11111111111111111111111111111111111111111
RATE_LIMIT_TX_PER_MINUTE=15

# Pool top-up from funder (periodic). SOL: POOL_TOPUP_THRESHOLD_SOL, POOL_TOPUP_INTERVAL_MS. USDC (when USDC_MINT set):
# POOL_TOPUP_USDC_THRESHOLD=10000
# POOL_TOPUP_USDC_AMOUNT=20000
# FUNDER_RESERVE_USDC=5000

# Dashboard
DASHBOARD_REFRESH_MS=2000

# Whether to run the colony in dry run mode.
DRY_RUN=false

# Whether to enable P2P matching.
P2P_MATCHING_ENABLED=true

# The amount of SOL each trader should have initially.
INITIAL_TRADER_SOL=0.2

# Funder tops traders up to this SOL level.
FUNDER_TRADER_TARGET_SOL=0.2